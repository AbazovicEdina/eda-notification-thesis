# Sets the CPU governor of all cores to "performance" at boot
# (DECISIONS.md 5.14). Without a fixed clock frequency the latency varies
# with the kernel's current frequency scaling. Installation: infra/pi/README.md.
[Unit]
Description=CPU-Governor "performance" für reproduzierbare Messungen
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
