# Setzt beim Booten den CPU-Governor aller Kerne auf "performance"
# (DECISIONS.md 5.14): Ohne feste Taktfrequenz schwankt die Latenz je nach
# momentaner Taktanpassung des Kernels. Installation: infra/pi/README.md.
[Unit]
Description=CPU-Governor "performance" für reproduzierbare Messungen
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
