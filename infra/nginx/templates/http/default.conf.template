# Front Nginx in "http" mode (DECISIONS.md 5.6.1). HTTP reverse proxy in
# front of all cells whose servers speak HTTP themselves, i.e. Node.js (SSE
# and WS), Ratchet and Reverb. PHP-FPM cells (SSE) use the "fastcgi" mode
# instead (templates/fastcgi/), so that every cell passes through exactly
# one Nginx, as in real operation. Each run targets exactly one cell.
# SUT_HOST/SUT_PORT select it, SUT_MODE the mode (tools/orchestrate
# switches both, docker-compose.yml mounts the matching template
# directory).
#
# $sut_upstream instead of a static `upstream {}` block. The value is
# resolved through a variable per request only (Docker resolver 127.0.0.11).
# A static upstream would make Nginx fail at start as soon as other SUT
# containers are stopped, which is exactly the normal case here (only the
# cells of the running campaign are started, DECISIONS.md 5.6.3).
resolver 127.0.0.11 valid=10s;

server {
    listen 80;

    set $sut_upstream http://${SUT_HOST}:${SUT_PORT};

    location /healthz {
        proxy_pass $sut_upstream;
    }

    # SSE: proxy_buffering MUST be off, otherwise Nginx holds back events until
    # its internal buffer is full, and the k6 latency measurement measures Nginx
    # buffering instead of the actual delivery to the client.
    location /sse {
        proxy_pass $sut_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        # Far above the event interval (the default of 60s would otherwise cut off
        # quiet SSE connections early).
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }

    # WebSocket: the upgrade headers are mandatory, otherwise it stays a normal
    # HTTP request and the handshake fails.
    location /ws {
        proxy_pass $sut_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }

    # WebSocket for Laravel Reverb (php-laravel/WS), Pusher protocol, path
    # /app/<app-key> instead of /ws (k6/scripts/ws-reverb.js). Same directives
    # as /ws above, so that all WS cells pass through the same proxy path.
    location /app/ {
        proxy_pass $sut_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }
}
