# Front Nginx in "fastcgi" mode (DECISIONS.md 5.6.1). Speaks FastCGI
# directly to the PHP-FPM pool of an SSE cell (php-minimal/SSE,
# php-laravel/SSE and its queue variant). This matches the usual way of
# running PHP-FPM (client -> Nginx -> PHP-FPM) and gives PHP exactly one
# Nginx, like the Node.js cells in "http" mode. The mandatory directives
# match those of the HTTP mode, no buffering and the same read timeout.
#
# SUT_HOST/SUT_PORT: FPM pool (e.g. php-minimal-fpm:9000)
# SUT_FASTCGI_SCRIPT, SUT_FASTCGI_SCRIPT_NAME, SUT_FASTCGI_ROOT: script in
# the FPM container (tools/orchestrate/cells.json)
resolver 127.0.0.11 valid=10s;

server {
    listen 80;

    set $sut_upstream ${SUT_HOST}:${SUT_PORT};

    # Built-in health endpoint of PHP-FPM (ping.path in fpm-pool.conf),
    # answered without a PHP script.
    location = /healthz {
        fastcgi_pass $sut_upstream;
        include fastcgi_params;
        fastcgi_param SCRIPT_NAME /healthz;
        fastcgi_param SCRIPT_FILENAME /healthz;
    }

    # SSE: fastcgi_buffering MUST be off, otherwise Nginx holds back events and
    # the latency measurement measures buffering instead of delivery.
    location /sse {
        fastcgi_pass $sut_upstream;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME ${SUT_FASTCGI_SCRIPT};
        fastcgi_param SCRIPT_NAME ${SUT_FASTCGI_SCRIPT_NAME};
        fastcgi_param DOCUMENT_ROOT ${SUT_FASTCGI_ROOT};
        fastcgi_buffering off;
        fastcgi_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }
}
