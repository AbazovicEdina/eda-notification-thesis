# Einheitliche Reverse-Proxy-Konfiguration vor ALLEN VIER Konfigurationen
# (PHP/SSE, PHP/WS, Node/SSE, Node/WS) — siehe DECISIONS.md 5.6: PHP braucht
# Nginx zwingend (FPM), Node nicht; ohne diese Vereinheitlichung hätte nur
# PHP einen zusätzlichen Hop. Jeder Lauf geht gegen genau eine Zelle;
# SUT_HOST/SUT_PORT wählen sie aus (tools/orchestrate schaltet sie um).
#
# $sut_upstream statt eines statischen `upstream {}`-Blocks: Der Wert wird
# über eine Variable erst pro Request aufgelöst (Docker-Resolver 127.0.0.11).
# Ein statischer Upstream würde Nginx beim Start scheitern lassen, sobald
# andere SUT-Container gestoppt sind — genau der Normalfall hier (nur die
# Zellen der laufenden Kampagne sind gestartet, DECISIONS.md 5.6.3).
resolver 127.0.0.11 valid=10s;

server {
    listen 80;

    set $sut_upstream http://${SUT_HOST}:${SUT_PORT};

    location /healthz {
        proxy_pass $sut_upstream;
    }

    # SSE — proxy_buffering MUSS aus sein: sonst hält Nginx Events zurück,
    # bis der interne Puffer voll ist, und die k6-Latenzmessung misst
    # Nginx-Pufferung statt tatsächliche Zustellung an den Client.
    location /sse {
        proxy_pass $sut_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        # Weit über dem Event-Intervall (Default 60s würde ruhige
        # SSE-Verbindungen sonst vorzeitig kappen).
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }

    # WebSocket — Upgrade-Header sind Pflicht, sonst bleibt es ein normaler
    # HTTP-Request und der Handshake schlägt fehl.
    location /ws {
        proxy_pass $sut_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }

    # WebSocket für Laravel Reverb (php-laravel/WS): Pusher-Protokoll, Pfad
    # /app/<app-key> statt /ws (k6/scripts/ws-reverb.js). Identische
    # Direktiven wie /ws oben, damit alle vier WS-Zellen denselben Proxy-Pfad
    # durchlaufen.
    location /app/ {
        proxy_pass $sut_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT}s;
    }
}
