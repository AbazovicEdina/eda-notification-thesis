{
  "_comment": "The measurement cells (DECISIONS.md 5.7, 5.19), the single source of truth for tools/orchestrate. services = all containers of the cell (started, measured and placed in a shared cgroup slice on the Pi, docker-compose.pi.yml). front = target and mode of the front Nginx (http = reverse proxy, fastcgi = directly to PHP-FPM). producer = event source (pubsub = event simulator on scan-events, bullmq = BullMQ jobs, laravel = Laravel jobs). script/metric/env = k6 measurement. A campaign can override script/metric/env per configuration.",
  "node-minimal-sse": {
    "language": "node", "variant": "minimal", "transport": "sse", "queue": false,
    "services": ["node-minimal-sse"],
    "front": { "mode": "http", "host": "node-minimal-sse", "port": 8080 },
    "producer": "pubsub",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  },
  "node-minimal-ws": {
    "language": "node", "variant": "minimal", "transport": "ws", "queue": false,
    "services": ["node-minimal-ws"],
    "front": { "mode": "http", "host": "node-minimal-ws", "port": 8080 },
    "producer": "pubsub",
    "script": "ws-skeleton.js", "metric": "ws_event_latency_ms", "metricPrefix": "ws"
  },
  "node-express-sse": {
    "language": "node", "variant": "framework", "transport": "sse", "queue": false,
    "services": ["node-express-sse"],
    "front": { "mode": "http", "host": "node-express-sse", "port": 8080 },
    "producer": "pubsub",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  },
  "node-express-ws": {
    "language": "node", "variant": "framework", "transport": "ws", "queue": false,
    "services": ["node-express-ws"],
    "front": { "mode": "http", "host": "node-express-ws", "port": 8080 },
    "producer": "pubsub",
    "script": "ws-skeleton.js", "metric": "ws_event_latency_ms", "metricPrefix": "ws"
  },
  "php-minimal-sse": {
    "language": "php", "variant": "minimal", "transport": "sse", "queue": false,
    "services": ["php-minimal-fpm"],
    "front": {
      "mode": "fastcgi", "host": "php-minimal-fpm", "port": 9000,
      "script": "/var/www/sse.php", "scriptName": "/sse.php", "root": "/var/www"
    },
    "producer": "pubsub",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  },
  "php-minimal-ws": {
    "language": "php", "variant": "minimal", "transport": "ws", "queue": false,
    "services": ["php-minimal-ws"],
    "front": { "mode": "http", "host": "php-minimal-ws", "port": 8080 },
    "producer": "pubsub",
    "script": "ws-skeleton.js", "metric": "ws_event_latency_ms", "metricPrefix": "ws"
  },
  "php-laravel-sse": {
    "language": "php", "variant": "framework", "transport": "sse", "queue": false,
    "services": ["php-laravel-fpm"],
    "front": {
      "mode": "fastcgi", "host": "php-laravel-fpm", "port": 9000,
      "script": "/var/www/public/index.php", "scriptName": "/index.php", "root": "/var/www/public"
    },
    "producer": "pubsub",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  },
  "php-laravel-ws": {
    "language": "php", "variant": "framework", "transport": "ws", "queue": false,
    "services": ["php-laravel-reverb", "php-laravel-listener"],
    "front": { "mode": "http", "host": "php-laravel-reverb", "port": 8080 },
    "producer": "pubsub",
    "script": "ws-reverb.js", "metric": "ws_event_latency_ms", "metricPrefix": "ws",
    "envFromFile": { "K6_REVERB_APP_KEY": { "file": "prototypes/php-laravel/.env", "key": "REVERB_APP_KEY" } }
  },
  "node-express-sse-queue": {
    "language": "node", "variant": "framework", "transport": "sse", "queue": true,
    "services": ["node-express-sse-queue", "node-express-worker"],
    "front": { "mode": "http", "host": "node-express-sse-queue", "port": 8080 },
    "producer": "bullmq",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  },
  "php-laravel-sse-queue": {
    "language": "php", "variant": "framework", "transport": "sse", "queue": true,
    "services": ["php-laravel-fpm-queue", "php-laravel-queue-worker"],
    "front": {
      "mode": "fastcgi", "host": "php-laravel-fpm-queue", "port": 9000,
      "script": "/var/www/public/index.php", "scriptName": "/index.php", "root": "/var/www/public"
    },
    "producer": "laravel",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  }
}
