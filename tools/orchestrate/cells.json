{
  "_comment": "Die Messzellen (DECISIONS.md 5.7, 5.19) — einzige Quelle der Wahrheit für tools/orchestrate. services = alle Container der Zelle (werden gestartet, gemessen und auf dem Pi in einen gemeinsamen cgroup-Topf gelegt, docker-compose.pi.yml); front = Ziel und Modus des Front-Nginx (http: Reverse-Proxy, fastcgi: direkt zu PHP-FPM); producer = Ereignisquelle (pubsub: Event-Simulator auf scan-events, bullmq: BullMQ-Jobs, laravel: Laravel-Jobs); script/metric/env = k6-Messung. Eine Kampagne kann script/metric/env pro Konfiguration überschreiben.",
  "node-minimal-sse": {
    "language": "node", "variant": "minimal", "transport": "sse", "queue": false,
    "services": ["node-minimal-sse"],
    "front": { "mode": "http", "host": "node-minimal-sse", "port": 8080 },
    "producer": "pubsub",
    "script": "sse-feasibility.js", "metric": "sse_event_latency_ms", "metricPrefix": "sse"
  },
