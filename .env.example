# Vorlage für die Umgebungs-Konfiguration.
# Kopieren nach .env und pro Umgebung anpassen. Die .env wird NIE committet.

COMPOSE_PROJECT_NAME=eda-thesis

## SSE-Machbarkeits-Endpunkt (tools/sse-feasibility)
SSE_FEASIBILITY_PORT=8081
SSE_EVENT_INTERVAL_MS=1000

## Host-Port-Freigaben (nur über docker-compose.override.yml wirksam)
HOST_SSE_FEASIBILITY_PORT=8081

## k6 (Ziele über Compose-Service-Namen, nicht localhost)
K6_TARGET_BASE_URL=http://sse-feasibility:8081
K6_VUS=50
K6_HOLD_SECONDS=60

## Einheitlicher Reverse-Proxy (infra/nginx) — wählt die aktive SUT-Konfiguration
## (DECISIONS.md 5.6.3: immer nur eine gleichzeitig). Beispiele für SUT_HOST:
## node-minimal-sse, node-minimal-ws, node-express, php-minimal, php-laravel
SUT_HOST=node-minimal-sse
SUT_PORT=8080
NGINX_PROXY_READ_TIMEOUT=3600

## Gemeinsamer Redis-Kanal für simulierte Scan-Events (siehe tools/event-simulator)
EVENT_CHANNEL=scan-events

## Ressourcen-Limits pro gemessenem SUT-Container (DECISIONS.md 5.6.2/5.10,
## Fairness-Regel — identisches Limit für alle acht Zellen). Platzhalter,
## bis die FH-Server-Hardware bekannt ist.
SUT_CPU_LIMIT=2
SUT_MEM_LIMIT=512m
