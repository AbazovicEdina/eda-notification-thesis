# Vorlage für die Umgebungs-Konfiguration.
# Kopieren nach .env und pro Umgebung anpassen. Die .env wird NIE committet.

COMPOSE_PROJECT_NAME=eda-thesis

## Nur auf dem Raspberry-Pi-Testserver einkommentieren: lädt die
## Pi-Ergänzung automatisch mit (Front-Nginx und Redis im LAN erreichbar,
## jede Zelle in ihrem eigenen cgroup-Topf — siehe infra/pi/README.md).
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml

## SSE-Machbarkeits-Endpunkt (tools/sse-feasibility)
SSE_FEASIBILITY_PORT=8081
SSE_EVENT_INTERVAL_MS=1000

## Host-Port-Freigaben (nur über docker-compose.override.yml wirksam)
HOST_SSE_FEASIBILITY_PORT=8081

## k6 — Startwerte für manuelle Einzelläufe. tools/orchestrate setzt Ziel,
## Clientzahl und Haltezeit pro Lauf selbst.
K6_TARGET_BASE_URL=http://sse-feasibility:8081
K6_VUS=50
K6_HOLD_SECONDS=60

## Einheitlicher Reverse-Proxy (infra/nginx) — Startwert für manuelle Tests;
## tools/orchestrate schaltet pro Lauf selbst um. Gültige Werte je Zelle
## (Container:Port, Quelle der Wahrheit: tools/orchestrate/cells.json):
##   node-minimal/SSE  node-minimal-sse:8080   node-minimal/WS  node-minimal-ws:8080
##   node-express/SSE  node-express-sse:8080   node-express/WS  node-express-ws:8080
##   php-minimal/SSE   php-minimal-nginx:8080  php-minimal/WS   php-minimal-ws:8080
##   php-laravel/SSE   php-laravel-nginx:8080  php-laravel/WS   php-laravel-reverb:8080
SUT_HOST=node-minimal-sse
SUT_PORT=8080
NGINX_PROXY_READ_TIMEOUT=3600

## Event-Simulator (tools/event-simulator). Die Rate setzt tools/orchestrate
## pro Laststufe. SIMULATOR_REDIS_HOST nur auf dem separaten Lastgenerator
## setzen (Adresse des Pi), lokal gilt der Compose-Service `redis`.
SIMULATOR_RATE=1
# SIMULATOR_REDIS_HOST=192.168.0.50

## Gemeinsamer Redis-Kanal für simulierte Scan-Events
EVENT_CHANNEL=scan-events

## Ressourcen-Budget pro Zelle (DECISIONS.md 5.6.2/5.10 — identisch für alle
## acht Zellen). Lokal als Limit pro Container, auf dem Pi zusätzlich als
## gemeinsamer cgroup-Topf pro Zelle (infra/pi/setup-slices.sh liest
## dieselben Werte). Speicher bewusst großzügig: RAM wird gemessen, nicht
## gedeckelt. Endwerte, sobald das Pi-Modell feststeht.
SUT_CPU_LIMIT=2
SUT_MEM_LIMIT=2g
