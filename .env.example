# Vorlage für die Umgebungs-Konfiguration.
# Kopieren nach .env und pro Umgebung anpassen. Die .env wird NIE committet.

COMPOSE_PROJECT_NAME=eda-thesis

## Nur auf dem Raspberry-Pi-Testserver einkommentieren: lädt die
## Pi-Ergänzung automatisch mit (Front-Nginx und Redis im LAN erreichbar,
## jede Zelle in ihrem eigenen cgroup-Topf — siehe infra/pi/README.md).
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml

## SSE-Machbarkeits-Endpunkt (tools/sse-feasibility)
SSE_FEASIBILITY_PORT=8081
SSE_EVENT_INTERVAL_MS=1000

## Host-Port-Freigaben (nur über docker-compose.override.yml wirksam)
HOST_SSE_FEASIBILITY_PORT=8081

## k6 — Startwerte für manuelle Einzelläufe. tools/orchestrate setzt Ziel,
## Clientzahl und Haltezeit pro Lauf selbst.
K6_TARGET_BASE_URL=http://sse-feasibility:8081
K6_VUS=50
K6_HOLD_SECONDS=60

## Front-Nginx (infra/nginx) — Startwert für manuelle Tests; tools/orchestrate
## schaltet pro Lauf selbst um. Quelle der Wahrheit: tools/orchestrate/cells.json.
## Modus http (Reverse-Proxy), SUT_HOST:SUT_PORT:
##   node-minimal-sse:8080  node-minimal-ws:8080  node-express-sse:8080
##   node-express-ws:8080   node-express-sse-queue:8080
##   php-minimal-ws:8080    php-laravel-reverb:8080
## Modus fastcgi (direkt zu PHP-FPM), SUT_HOST:SUT_PORT und Skript:
##   php-minimal-fpm:9000        /var/www/sse.php           (SCRIPT_NAME /sse.php,   ROOT /var/www)
##   php-laravel-fpm:9000        /var/www/public/index.php  (SCRIPT_NAME /index.php, ROOT /var/www/public)
##   php-laravel-fpm-queue:9000  wie php-laravel-fpm
SUT_MODE=http
SUT_HOST=node-minimal-sse
SUT_PORT=8080
# SUT_FASTCGI_SCRIPT=/var/www/sse.php
# SUT_FASTCGI_SCRIPT_NAME=/sse.php
# SUT_FASTCGI_ROOT=/var/www
NGINX_PROXY_READ_TIMEOUT=3600

## Betriebsmodus der Prototypen (DECISIONS.md 5.5). Standard ist Produktion
## nach offizieller Dokumentation; nur für die Fehlersuche umschalten.
## Pilot-, Haupt- und Kontrollkampagnen brechen ab, wenn eine Zelle nicht im
## Produktionsbetrieb läuft.
# LARAVEL_APP_ENV=local
# LARAVEL_APP_DEBUG=true
# LARAVEL_LOG_LEVEL=debug
# SUT_NODE_ENV=development

## Event-Simulator (tools/event-simulator). Die Rate setzt tools/orchestrate
## pro Laststufe. SIMULATOR_REDIS_HOST nur auf dem separaten Lastgenerator
## setzen (Adresse des Pi), lokal gilt der Compose-Service `redis`.
SIMULATOR_RATE=1
# SIMULATOR_REDIS_HOST=192.168.0.50

## Gemeinsamer Redis-Kanal für simulierte Scan-Events
EVENT_CHANNEL=scan-events

## Ressourcen-Budget pro Zelle (DECISIONS.md 5.6.2/5.10 — identisch für alle
## zehn Zellen). Lokal als Limit pro Container, auf dem Pi zusätzlich als
## gemeinsamer cgroup-Topf pro Zelle (infra/pi/setup-slices.sh liest
## dieselben Werte). Werte für den Raspberry Pi 5 mit 4 GB: zwei Zellen
## à 1536 MiB plus System passen ohne Swap in den Arbeitsspeicher
## (setup-slices.sh prüft das). Für php-laravel/SSE bei 500 Clients reicht
## das nicht, für einen Pi mit 8 GB sind 3g vorgesehen (DECISIONS.md 5.10).
SUT_CPU_LIMIT=2
SUT_MEM_LIMIT=1536m

## Benachrichtigung im Dauerbetrieb (tools/orchestrate/notify.js), nur auf
## dem Rechner nötig, auf dem schedule.js und status.js laufen. Ein
## öffentliches ntfy-Thema kann jeder lesen, der den Namen kennt; die
## Nachrichten enthalten daher keine Messwerte, Adressen oder Schlüssel.
# NOTIFY_URL=https://ntfy.sh/<thema>
