# Template for the environment configuration.
# Copy to .env and adjust per environment. The .env is NEVER committed.

COMPOSE_PROJECT_NAME=eda-thesis

## Uncomment only on the Raspberry Pi test server. Loads the Pi addition
## automatically (front Nginx and Redis reachable on the LAN, each cell in
## its own cgroup slice, see infra/pi/README.md).
## COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml

## SSE feasibility endpoint (tools/sse-feasibility)
SSE_FEASIBILITY_PORT=8081
SSE_EVENT_INTERVAL_MS=1000

## Host port mappings (only effective via docker-compose.override.yml)
HOST_SSE_FEASIBILITY_PORT=8081

## k6, start values for manual single runs. tools/orchestrate sets target,
## number of clients and hold time per run itself.
K6_TARGET_BASE_URL=http://sse-feasibility:8081
K6_VUS=50
K6_HOLD_SECONDS=60

## Front Nginx (infra/nginx), start value for manual tests. tools/orchestrate
## switches it per run itself. Source of truth: tools/orchestrate/cells.json.
## Mode http (reverse proxy), SUT_HOST:SUT_PORT:
##   node-minimal-sse:8080  node-minimal-ws:8080  node-express-sse:8080
##   node-express-ws:8080   node-express-sse-queue:8080
##   php-minimal-ws:8080    php-laravel-reverb:8080
## Mode fastcgi (directly to PHP-FPM), SUT_HOST:SUT_PORT and script:
##   php-minimal-fpm:9000        /var/www/sse.php           (SCRIPT_NAME /sse.php,   ROOT /var/www)
##   php-laravel-fpm:9000        /var/www/public/index.php  (SCRIPT_NAME /index.php, ROOT /var/www/public)
##   php-laravel-fpm-queue:9000  same as php-laravel-fpm
SUT_MODE=http
SUT_HOST=node-minimal-sse
SUT_PORT=8080
# SUT_FASTCGI_SCRIPT=/var/www/sse.php
# SUT_FASTCGI_SCRIPT_NAME=/sse.php
# SUT_FASTCGI_ROOT=/var/www
NGINX_PROXY_READ_TIMEOUT=3600

## Operating mode of the prototypes (DECISIONS.md 5.5). The default is
## production according to the official documentation, switch only for
## debugging. Pilot, main and control campaigns abort if a cell does not run
## in production mode.
## LARAVEL_APP_ENV=local
## LARAVEL_APP_DEBUG=true
## LARAVEL_LOG_LEVEL=debug
## SUT_NODE_ENV=development

## Event simulator (tools/event-simulator). tools/orchestrate sets the rate
## per load level. Set SIMULATOR_REDIS_HOST only on the separate load
## generator (address of the Pi), locally the Compose service `redis` applies.
SIMULATOR_RATE=1
# SIMULATOR_REDIS_HOST=192.168.50.10

## Shared Redis channel for simulated scan events
EVENT_CHANNEL=scan-events

## Resource budget per cell (DECISIONS.md 5.6.2, 5.10, identical for all ten
## cells). Locally a limit per container, on the Pi additionally a shared
## cgroup slice per cell (infra/pi/setup-slices.sh reads the same values).
## Values for the Raspberry Pi 5 with 4 GB, two cells of 1536 MiB each plus
## the system fit into memory without swap (setup-slices.sh checks this).
## This is enough for all cells at 500 clients, because the clients connect
## spread out (DECISIONS.md 5.10).
SUT_CPU_LIMIT=2
SUT_MEM_LIMIT=1536m

## Notification during unattended operation (tools/orchestrate/notify.js),
## only needed on the machine that runs schedule.js and status.js. A public
## ntfy topic can be read by anyone who knows its name, so the messages
## contain no measurement values, addresses or keys.
## NOTIFY_URL=https://ntfy.sh/<topic>
